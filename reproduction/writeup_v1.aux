\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Mess3 emergence over training.} Top: supervised decode at steps $100, 1000, 5000, 10^6$. Bottom: spectral-OOM subspace activations (affine-aligned for display). Both show identical emergence trajectory.}}{4}{figure.caption.4}\protected@file@percent }
