\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {RRXOR diagnostics, supervised (paper Fig.~7D--E).} \emph  {Left:} per-activation belief-reconstruction MSE --- RRXOR's geometry is spread across all layers (every single layer high; the concatenation lowest), while Mess3 carries it in every layer. \emph  {Centre/right:} over the $36$ belief states, the representation preserves belief distances ($R^2\approx 0.78$) but not next-token distances ($R^2\approx 0.31$) --- the geometry is more than next-token.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:rrxordiag}{{4}{4}{\textbf {RRXOR diagnostics, supervised (paper Fig.~7D--E).} \emph {Left:} per-activation belief-reconstruction MSE --- RRXOR's geometry is spread across all layers (every single layer high; the concatenation lowest), while Mess3 carries it in every layer. \emph {Centre/right:} over the $36$ belief states, the representation preserves belief distances ($R^2\approx 0.78$) but not next-token distances ($R^2\approx 0.31$) --- the geometry is more than next-token}{figure.caption.5}{}}
