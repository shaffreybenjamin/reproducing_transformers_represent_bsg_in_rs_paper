\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {RRXOR, supervised vs.\ unsupervised.} Ground truth (left); supervised full-residual recovery (centre, per-position $R^2=0.91$); unsupervised $5$-D observability-OOM subspace (right, per-position $R^2=0.65$, state-COM $R^2\approx 0.82$). Identical pipeline; only the affine-map input differs. Placement onto the simplex uses a label-fit readout in \emph  {both} panels (display only --- the unsupervised content is the subspace).}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:rrxorcomp}{{8}{9}{\textbf {RRXOR, supervised vs.\ unsupervised.} Ground truth (left); supervised full-residual recovery (centre, per-position $R^2=0.91$); unsupervised $5$-D observability-OOM subspace (right, per-position $R^2=0.65$, state-COM $R^2\approx 0.82$). Identical pipeline; only the affine-map input differs. Placement onto the simplex uses a label-fit readout in \emph {both} panels (display only --- the unsupervised content is the subspace)}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {RRXOR diagnostics, unsupervised counterpart.} \emph  {Left:} per-activation belief-decode MSE from each activation's observability-OOM subspace --- ``belief spread across layers'' is recovered without labels (cf.\ Figure~\ref {fig:rrxordiag}). \emph  {Centre/right:} distance preservation of the recovered representation --- unlike the supervised case it leans toward next-token ($R^2\approx 0.68$) over belief ($R^2\approx 0.50$), because the observability subspace is anchored on the next-token observable.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:rrxordiagB}{{9}{9}{\textbf {RRXOR diagnostics, unsupervised counterpart.} \emph {Left:} per-activation belief-decode MSE from each activation's observability-OOM subspace --- ``belief spread across layers'' is recovered without labels (cf.\ Figure~\ref {fig:rrxordiag}). \emph {Centre/right:} distance preservation of the recovered representation --- unlike the supervised case it leans toward next-token ($R^2\approx 0.68$) over belief ($R^2\approx 0.50$), because the observability subspace is anchored on the next-token observable}{figure.caption.12}{}}
