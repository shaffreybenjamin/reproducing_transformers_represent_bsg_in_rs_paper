# RunPod automation config. Copy to `config.env` and fill in.
#   cp runpod/config.env.example runpod/config.env
# config.env is gitignored — it holds your secret API key.

# --- required secrets ---
RUNPOD_API_KEY=                      # https://console.runpod.io/user/settings -> API Keys
RUNPOD_VOLUME_ID=                    # leave blank; setup.sh creates one and fills it in

# --- GPU / pod ---
# Comma-separated ORDERED fallback list. RunPod picks the first one in stock in the
# volume's datacenter (gpuTypePriority=availability). Give several so a single card being
# out of stock doesn't fail the run. Use exact ids from the POST /pods enum.
RUNPOD_GPU_TYPE="NVIDIA RTX A4500,NVIDIA RTX 2000 Ada Generation,NVIDIA L4,NVIDIA GeForce RTX 4090"
RUNPOD_IMAGE="runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04"
                                     # ^ confirm this tag exists in the RunPod PyTorch template (console).
                                     #   uv installs its own python+torch on the volume, so the image only
                                     #   needs a recent CUDA 12 driver — any current runpod/pytorch cuda12 image works.
# Only schedule on hosts whose NVIDIA driver supports these CUDA versions. Must match what
# your installed torch needs (torch 2.9's default wheel needs CUDA 12.8+); otherwise the
# pod fails at torch._C._cuda_init() with "driver too old". Leave blank to let RunPod pick any.
RUNPOD_ALLOWED_CUDA="12.8,12.9,13.0"
RUNPOD_CONTAINER_DISK_GB=50
RUNPOD_POD_NAME="ben-mess3"          # a pod name prefix; a timestamp is appended per run

# --- network volume (used only by setup.sh when creating it) ---
RUNPOD_DATACENTER="EU-RO-1"          # must support network volumes AND public IP (EU-RO-1 does)
VOLUME_SIZE_GB=50

# --- local ssh key (must be added to your RunPod account) ---
SSH_KEY="$HOME/.ssh/id_ed25519"
SSH_PUBKEY="$HOME/.ssh/id_ed25519.pub"

# --- result handling ---
AUTO_PUSH=true                       # after a run, git commit results and `git push` so others can pull them
